    print()
    print("Coverage:")
    for key in (
        "DIRECT",
        "SUFFICIENT",
        "PARTIAL",
        "ABSENT",
        "NOT_APPLICABLE",
    ):
        print(
            f"  {key:<20}: "
            f"{coverage_counts.get(key, 0)}"
        )

    print()
    print("TR result matrix:")
